# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

{{- if eq .chezmoi.os "darwin" }}
eval $(/opt/homebrew/bin/brew shellenv)
export PATH="/opt/homebrew/opt/coreutils/libexec/gnubin:$PATH"
export PATH="/opt/homebrew/opt/gnu-sed/libexec/gnubin:$PATH"
export PATH="/opt/homebrew/opt/grep/libexec/gnubin:$PATH"
export PATH="/opt/homebrew/opt/openssl@3/bin:$PATH"
export PATH="/opt/homebrew/opt/make/libexec/gnubin:$PATH"
{{- end }}
export PATH="${PATH}:${HOME}/.krew/bin"

# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="powerlevel10k/powerlevel10k"

COMPLETION_WAITING_DOTS="true"

plugins=(
  git
  encode64
  kubectl
  kube-ps1
  terraform
  docker
  helm
  zsh-autosuggestions
  zsh-syntax-highlighting
  openstack
  azurerepos
  vault-credentials)

{{- if eq .chezmoi.os "darwin" }}
FPATH="${HOMEBREW_PREFIX}/share/zsh/site-functions:${FPATH}"
{{- else if eq .chezmoi.os "linux" }}
FPATH="/usr/share/zsh/site-functions:${FPATH}"
{{- end}}
fpath=($fpath ~/.zsh/completion)

# op ships no zsh completion file, generate it once
if (( $+commands[op] )) && [[ ! -f ~/.zsh/completion/_op ]]; then
  mkdir -p ~/.zsh/completion && op completion zsh >| ~/.zsh/completion/_op
fi

source $ZSH/oh-my-zsh.sh

export GOPRIVATE={{ get . "goprivate" | default "dev.azure.com" }}
export GOPATH=~/Go
export GOBIN=$GOPATH/bin
export PATH=$PATH:$GOPATH/bin
export FLUX_FORWARD_NAMESPACE="flux"

export HOMEBREW_AUTO_UPDATE_SECS=86400
export EDITOR="nvim"

# aliases
{{- if eq .chezmoi.os "darwin" }}
alias docker='container'
{{- else }}
alias docker='nerdctl'
{{- end }}
alias wget='curl -O'
alias fastcommit='git commit . -m "$(curl -s https://whatthecommit.com/index.txt)"'
alias watch="watch "
alias k9s="sofka"

{{- if eq .chezmoi.os "linux" }}
alias open="xdg-open"
{{- end }}

command -v pwgen >/dev/null && alias pwgencp='echo -n "$(pwgen -scn 32 1)" | pbcopy'
alias ls='ls --color=auto'
{{- if eq .chezmoi.os "darwin" }}

# yay brew
yay() {
  if [[ $1 == "" ]]; then
    brew update && brew upgrade
  else
    brew $@
  fi
}
{{- end }}

# kubePS1 config
get_kubecluster_color() {
    if [[ $KUBE_PS1_CONTEXT == *"prod"* ]]; then
        KUBE_PS1_CTX_COLOR=red
    elif [[ $KUBE_PS1_CONTEXT == *"test"* ]]; then
        KUBE_PS1_CTX_COLOR=yellow
    elif [[ $KUBE_PS1_CONTEXT == *"dev"* ]]; then
        KUBE_PS1_CTX_COLOR=green
    else
        KUBE_PS1_CTX_COLOR=blue
    fi
}
KUBE_PS1_BEFORE_FUNCTION=get_kubecluster_color
KUBE_PS1_NS_ENABLE=true
KUBE_PS1_PREFIX=[
KUBE_PS1_SUFFIX=]
#RPROMPT='$(kube_ps1)'

# k8s aliases
command -v kubectl >/dev/null && compdef kubecolor=kubectl
command -v kubectl >/dev/null && alias kubectl=kubecolor
command -v kubectl >/dev/null && alias ktp="kubectl top pods"
command -v kubectl >/dev/null && alias ktno="kubectl top nodes"
command -v kubectl >/dev/null && alias kdebug="kubectl run dibi-debug --rm -i --tty --image nicolaka/netshoot -- /bin/bash"

# Completion suggestions
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=7"
bindkey '^ ' autosuggest-accept

zstyle ':completion:*' special-dirs true

autoload -U +X bashcompinit && bashcompinit

## Azure CLI Completion
if [[ -r "/opt/homebrew/etc/bash_completion.d/az" ]]; then
  source /opt/homebrew/etc/bash_completion.d/az
fi

# for history search
bindkey '^[[A' up-line-or-search
bindkey '^[[B' down-line-or-search

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
{{- if eq .chezmoi.os "darwin" }}

export PATH="/opt/homebrew/opt/mysql-client/bin:$PATH"
{{- end }}


[[ -f ~/.config/op/plugins.sh ]] && source ~/.config/op/plugins.sh

# Added by LM Studio CLI (lms)
export PATH="$PATH:{{ .chezmoi.homeDir }}/.lmstudio/bin"
# End of LM Studio CLI section

